# Twelve Data API key (free tier: 800 requests/day, 8/min). Get one at
# https://twelvedata.com/pricing — required for any market data (stocks or crypto).
TWELVE_DATA_API_KEY=

# Local SQLite file path. Optional — defaults to ./trading.db if unset.
DATABASE_PATH=trading.db

# Supabase project used by Jarvis's server-only cloud memory. Apply the SQL
# migration in supabase/migrations before enabling these values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional namespace for an isolated Jarvis memory container.
JARVIS_MEMORY_CONTAINER=trading-hub
